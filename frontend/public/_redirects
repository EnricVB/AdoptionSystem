# Redirect all routes to index.html for Angular SPA
/*    /index.html   200

# API routes should not be redirected (if you have API calls)
/api/*  /api/:splat  200

# Static assets should be served directly
/assets/*  /assets/:splat  200
/media/*   /media/:splat   200
/*.js      /:splat         200
/*.css     /:splat         200
/*.png     /:splat         200
/*.jpg     /:splat         200
/*.svg     /:splat         200
/*.ico     /:splat         200
